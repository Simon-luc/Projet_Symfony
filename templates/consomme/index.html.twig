{% extends 'base.html.twig' %}

{% block title %}Consomme index{% endblock %}

{% block body %}
    <h1>Consomme index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date_consommation</th>
                <th>Quantite_consomme</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for consomme in consommes %}
            <tr>
                <td>{{ consomme.id }}</td>
                <td>{{ consomme.dateConsommation ? consomme.dateConsommation|date('Y-m-d') : '' }}</td>
                <td>{{ consomme.quantiteConsomme }}</td>
                <td>
                    <a href="{{ path('app_consomme_show', {'id': consomme.id}) }}">show</a>
                    <a href="{{ path('app_consomme_edit', {'id': consomme.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_consomme_new') }}">Create new</a>
{% endblock %}
